-- Spectate logic
local target = nil
local renderStepName = "StableSpectateCamera"

local function getHumanoid(playerToCheck)
	local character = playerToCheck and playerToCheck.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function setCameraSubject(humanoid)
	local currentCamera = workspace.CurrentCamera
	if currentCamera and humanoid and currentCamera.CameraSubject ~= humanoid then
		currentCamera.CameraType = Enum.CameraType.Custom
		currentCamera.CameraSubject = humanoid
	end
end

local function stop()
	target = nil
	title.Text = "Not spectating"

	local humanoid = getHumanoid(player)
	if humanoid then
		setCameraSubject(humanoid)
	end
end

local function setTarget(playerToSpectate)
	if not playerToSpectate or playerToSpectate == player then
		stop()
		return
	end

	target = playerToSpectate
	title.Text = "Spectating: " .. playerToSpectate.Name

	local humanoid = getHumanoid(playerToSpectate)
	if humanoid then
		setCameraSubject(humanoid)
	end
end

local function getOthers()
	local list = {}

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			table.insert(list, otherPlayer)
		end
	end

	return list
end

local function step(dir)
	local list = getOthers()

	if #list == 0 then
		stop()
		return
	end

	local index = table.find(list, target) or 0

	if index == 0 then
		index = dir > 0 and 1 or #list
	else
		index = ((index - 1 + dir) % #list) + 1
	end

	setTarget(list[index])
end

prevBtn.MouseButton1Click:Connect(function()
	step(-1)
end)

stopBtn.MouseButton1Click:Connect(stop)

nextBtn.MouseButton1Click:Connect(function()
	step(1)
end)

toggle.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible
	toggle.Text = panel.Visible and "Close" or "Spectate"
end)

-- Recheck after Roblox's camera update, in case another script changes
-- the camera subject or the CurrentCamera gets replaced.
RunService:BindToRenderStep(
	renderStepName,
	Enum.RenderPriority.Camera.Value + 1,
	function()
		if not target or target.Parent ~= Players then
			return
		end

		local humanoid = getHumanoid(target)
		if humanoid then
			setCameraSubject(humanoid)
		end
	end
)

-- Reattach when the spectated player respawns.
local targetCharacterConnection

local function watchTarget(playerToWatch)
	if targetCharacterConnection then
		targetCharacterConnection:Disconnect()
		targetCharacterConnection = nil
	end

	if playerToWatch then
		targetCharacterConnection = playerToWatch.CharacterAdded:Connect(function(character)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if target == playerToWatch and humanoid then
				setCameraSubject(humanoid)
			end
		end)
	end
end

local originalSetTarget = setTarget
setTarget = function(playerToSpectate)
	originalSetTarget(playerToSpectate)
	watchTarget(target)
end

local originalStop = stop
stop = function()
	watchTarget(nil)
	originalStop()
end

Players.PlayerRemoving:Connect(function(leaving)
	if leaving ~= target then
		return
	end

	local list = getOthers()
	local leavingIndex = table.find(list, leaving) or 1
	table.remove(list, leavingIndex)

	if #list == 0 then
		stop()
	else
		setTarget(list[math.min(leavingIndex, #list)])
	end
end)
